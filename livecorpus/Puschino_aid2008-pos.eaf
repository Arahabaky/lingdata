        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a483"
                TIME_SLOT_REF1="ts119" TIME_SLOT_REF2="ts120">
                <ANNOTATION_VALUE>Причем моя склонница, которая мега-фанатка.</ANNOTATION_VALUE>
